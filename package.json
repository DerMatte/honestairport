{
  "name": "travelguide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:content && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/*.test.ts lib/**/*.test.ts tests/**/*.test.ts tests/**/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-airports.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:dev": "tsx scripts/dev-postgres.ts",
    "guide": "tsx scripts/guide.ts",
    "generate:airport": "tsx --env-file-if-exists=.env.local scripts/generate-airport.ts",
    "generate:airport:grok": "tsx --env-file-if-exists=.env.local scripts/generate-airport-grok.ts",
    "generate:airports": "tsx --env-file-if-exists=.env.local scripts/generate-airports-batch.ts",
    "rebuild:airports": "tsx --env-file-if-exists=.env.local scripts/rebuild-airports-gateway.ts",
    "review:airports": "tsx --env-file-if-exists=.env.local scripts/review-airport-pages.ts",
    "seed:lounges": "tsx --env-file-if-exists=.env.local scripts/seed-lounges-from-guides.ts",
    "sync:forum": "tsx --env-file-if-exists=.env.local scripts/sync-community-forum.ts",
    "sync:images": "tsx --env-file-if-exists=.env.local scripts/sync-airport-images.ts",
    "sync:lounge-images": "tsx --env-file-if-exists=.env.local scripts/sync-lounge-images.ts",
    "sync:lounge-press": "tsx --env-file-if-exists=.env.local scripts/sync-lounge-press-images.ts",
    "sync:lounges": "tsx --env-file-if-exists=.env.local scripts/sync-lounges.ts",
    "sync:ratings": "tsx --env-file-if-exists=.env.local scripts/sync-google-ratings.ts",
    "sync:water": "tsx --env-file-if-exists=.env.local scripts/sync-water-options.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.165",
    "@ai-sdk/openai": "^3.0.90",
    "@ai-sdk/react": "^3.0.245",
    "@ai-sdk/xai": "^4.0.28",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@hookform/resolvers": "^5.7.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vis.gl/react-maplibre": "^8.1.2",
    "@whop/sdk": "^0.0.42",
    "@x402/core": "^2.22.0",
    "@x402/evm": "^2.22.0",
    "@x402/next": "^2.22.0",
    "ai": "^6.0.243",
    "better-auth": "^1.6.26",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exif-reader": "^2.0.3",
    "gray-matter": "^4.0.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.28.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.24.0",
    "mcp-handler": "^2.1.1",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "shadcn": "^4.16.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.26",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3",
      "esbuild",
      "sharp",
      "embedded-postgres",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64"
    ]
  }
}
