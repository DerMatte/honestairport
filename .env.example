# Required for scripts/generate-airport.ts (Vercel AI Gateway with xAI access)
AI_GATEWAY_API_KEY=

# Required for scripts/review-airport-pages.ts (Cursor SDK local agent)
# Create at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Postgres connection for user reviews (any provider: Neon, Supabase, RDS, ...).
# Without it the site still works - review sections degrade gracefully.
# For local development, `pnpm db:dev` boots a disposable Postgres:
# DATABASE_URL=postgres://dev:dev@127.0.0.1:54329/honestairport
DATABASE_URL=

# Better Auth (logins). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 in dev, https://<domain> in production
BETTER_AUTH_URL=

# Optional: Resend for verification + password-reset emails.
# Without RESEND_API_KEY, local/dev logs the link to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Blob store. Used by the image sync scripts and by review photo
# uploads (POST /api/airports/[iata]/reviews) - without it, reviews still post
# but attaching photos returns 503. Vercel injects it once a Blob store is
# linked to the project; set it by hand for local uploads.
BLOB_READ_WRITE_TOKEN=

# Shared secret for POST /api/revalidate (content pipeline cache bust).
REVALIDATE_SECRET=

# Canonical public site origin (used for absolute URLs + same-origin checks).
NEXT_PUBLIC_SITE_URL=

# Optional rideshare / transfer monetization (Getting There tab).
# Uber developer client ID — added to ride deep links for partner attribution.
# https://developer.uber.com/dashboard
NEXT_PUBLIC_UBER_CLIENT_ID=
# Uber Impact affiliate landing URL (new-rider acquisition only; apply at
# https://www.uber.com/us/en/affiliate-program/). Shown as a "New to Uber?" link.
NEXT_PUBLIC_UBER_AFFILIATE_URL=
# Travelpayouts partner marker — wraps GetTransfer + Kiwitaxi quote links so
# completed airport→city transfer bookings earn commission (4–25%).
# https://www.travelpayouts.com/
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=

# Optional social logins - the buttons only render when the vars are set.
# GitHub OAuth app callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple Services ID + pre-generated ES256 client-secret JWT (<=180 days,
# rotate before expiry). Return URL: <BETTER_AUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional x402 machine payments for airport/lounge markdown (the agent API).
# Leave X402_PAY_TO empty to keep those routes free (default — no surprise paywall).
# This is a public receive address only. Never put a private key on the server.
# First slice defaults: Base Sepolia + the public x402.org facilitator.
# Mainnet later: X402_NETWORK=eip155:8453 and a production facilitator URL.
# X402_PAY_TO=0xYourPublicReceiveAddress
# X402_NETWORK=eip155:84532
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_PRICE=$0.01

# Optional Whop membership gate for extra airport tabs + lounge pages ($8/month).
# Overview and the lounge directory stay free. Leave WHOP_API_KEY empty to
# keep HTML ungated (default — no surprise lock).
# Product and checkout already exist — do not recreate them.
# Company API key: Whop dashboard → HonestAirport → Developer → API keys
# (needs payment:basic:read, plan:basic:read, access_pass:basic:read, member:basic:read).
# Session cookie reuses BETTER_AUTH_SECRET (32+ chars). Optional override: WHOP_SESSION_SECRET.
# Members Telegram (exp_bY2X6xJXubn5wv) is attached on Whop — not a bot in this repo.
# WHOP_API_KEY=
# WHOP_COMPANY_ID=biz_7f2K9NIDw78ErX
# WHOP_PRODUCT_ID=prod_F5F5XD1OGhQoK
# NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_ee0kSfuyD6v9a
